# Copy this file to .env locally, or configure environment variables on Render.
# Keep credentials PRIVATE; never commit real secrets.
APP_ENV=development
DEBUG=false
# Replace with your PRIVATE PostgreSQL Session Pooler connection URI from Supabase Dashboard -> Connect.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<supabase-session-pooler-host>:5432/postgres?sslmode=require
SUPABASE_URL=https://bszyxstmdywwexelaxaq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_VURDMKM6jXV6axYyVT7jrg_58pTtGe5
# Set ONLY in the private Render environment or your local ignored .env file.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scheduled-om-evidence
# Optional only for projects still using the legacy HS256 JWT signing secret.
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BOOTSTRAP_ADMIN_EMAILS=
APP_PUBLIC_URL=http://localhost:8000
# Leave disabled on web replicas; opt in only on one continuously running worker.
PM_DAILY_JOB=0

# Optional AI-generated Ask Solar91 responses. Disabled unless BOTH opt-in and key are supplied.
# If off, Ask Solar91 uses permission-scoped, live operational search.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
AI_ASSISTANT_MODEL=gpt-4.1-mini
